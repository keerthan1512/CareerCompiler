{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://careercompiler.dev/schemas/match_result.schema.json",
  "title": "MatchResult",
  "description": "Result of mapping a JD requirement to resume evidence (Phase 3)",
  "type": "object",
  "required": ["id", "job_id", "requirement_id", "category", "confidence"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "master_resume_id": { "type": "string", "format": "uuid" },
    "requirement_id": { "type": "string", "format": "uuid" },
    "requirement_text": { "type": "string" },
    "evidence_id": { "type": "string", "format": "uuid" },
    "evidence_text": { "type": "string" },
    "evidence_source_ref": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "line_start": { "type": "integer" },
        "line_end": { "type": "integer" }
      }
    },
    "category": { "type": "string", "enum": ["Direct", "Transferable", "Gap"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "similarity_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "keyword_overlap_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "explanation": { "type": "string" },
    "matched_at": { "type": "string", "format": "date-time" }
  }
}
